{
  "name": "@reckona/example-docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm sync:api && pnpm sync:benchmarks && mreact-router build --target=node && tsx scripts/export-static.ts && pagefind --site dist",
    "dev": "pnpm sync:api && pnpm sync:benchmarks && mreact-router dev",
    "diagnose:dev-latency": "tsx scripts/measure-dev-latency.ts",
    "lint": "oxlint . --ignore-pattern .mreact --ignore-pattern dist",
    "start": "mreact-router start .mreact",
    "sync:api": "tsx scripts/sync-api-reference.ts",
    "sync:benchmarks": "tsx scripts/sync-benchmark-results.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm sync:api && pnpm sync:benchmarks && tsc --noEmit"
  },
  "dependencies": {
    "@reckona/mreact": "workspace:*",
    "@reckona/mreact-router": "workspace:*"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.2.0",
    "@tailwindcss/vite": "4.3.0",
    "pagefind": "^1.5.2",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  }
}
