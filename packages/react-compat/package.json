{
  "name": "@reckona/mreact-compat",
  "version": "0.0.10",
  "description": "React-compatible runtime implementation for mreact.",
  "keywords": [
    "compatibility",
    "jsx",
    "mreact",
    "react",
    "runtime",
    "typescript"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/react-compat#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/react-compat"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "default": "./dist/scheduler.js"
    },
    "./event-priority": {
      "types": "./dist/event-priority.d.ts",
      "default": "./dist/event-priority.js"
    },
    "./flight": {
      "types": "./dist/flight.d.ts",
      "default": "./dist/flight.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reckona/mreact-shared": "workspace:*"
  }
}
