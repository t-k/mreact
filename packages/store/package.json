{
  "name": "@reckona/mreact-store",
  "version": "0.0.141",
  "description": "Global and shared reactive state primitives for mreact.",
  "keywords": [
    "jsx",
    "mreact",
    "reactive",
    "state",
    "store",
    "typescript"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/store#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/store"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reckona/mreact-devtools": "workspace:*",
    "@reckona/mreact-reactive-core": "workspace:*"
  }
}
