{
  "name": "@reckona/mreact-dom",
  "version": "0.0.140",
  "description": "React DOM-compatible entrypoints for mreact.",
  "keywords": [
    "dom",
    "jsx",
    "mreact",
    "react-dom",
    "ssr",
    "typescript"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/react-dom#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/react-dom"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server.browser": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server.edge": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server.node": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils.d.ts",
      "default": "./dist/test-utils.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reckona/mreact-compat": "workspace:*"
  }
}
