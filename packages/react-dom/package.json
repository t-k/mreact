{
  "name": "@reckona/mreact-dom",
  "version": "19.2.6-modular.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/react-dom"
  },
  "files": [
    "dist"
  ],
  "type": "module",
