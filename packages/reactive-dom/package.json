{
  "name": "@reckona/mreact-reactive-dom",
  "version": "0.0.161",
  "description": "Fine-grained DOM binding runtime for compiled mreact output.",
  "keywords": [
    "compiler-runtime",
    "dom",
    "jsx",
    "mreact",
    "reactivity",
    "typescript"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/reactive-dom#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/reactive-dom"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reckona/mreact-reactive-core": "workspace:*",
    "@reckona/mreact-shared": "workspace:*"
  }
}
