{
  "name": "@reckona/mreact-shared",
  "version": "0.0.200",
  "description": "Shared runtime utilities used by mreact packages.",
  "keywords": [
    "jsx",
    "mreact",
    "shared",
    "typescript",
    "utilities"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/shared#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/shared"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./url-safety": {
      "types": "./dist/url-safety.d.ts",
      "default": "./dist/url-safety.js"
    },
    "./html-escape": {
      "types": "./dist/html-escape.d.ts",
      "default": "./dist/html-escape.js"
    },
    "./compiler-contract": {
      "types": "./dist/compiler-contract.d.ts",
      "default": "./dist/compiler-contract.js"
    },
    "./dom-prop-names": {
      "types": "./dist/dom-prop-names.d.ts",
      "default": "./dist/dom-prop-names.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
