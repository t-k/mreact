{
  "name": "@reckona/mreact-router",
  "version": "0.0.2",
  "description": "File-system app router, SSR, actions, and deployment adapters for mreact.",
  "keywords": [
    "jsx",
    "mreact",
    "router",
    "server-actions",
    "ssr",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/router#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/router"
  },
  "bin": {
    "mreact-router": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/edge": {
      "types": "./dist/adapters/edge.d.ts",
      "default": "./dist/adapters/edge.js"
    },
    "./adapters/cloudflare": {
      "types": "./dist/adapters/cloudflare.d.ts",
      "default": "./dist/adapters/cloudflare.js"
    },
    "./adapters/aws-lambda": {
      "types": "./dist/adapters/aws-lambda.d.ts",
      "default": "./dist/adapters/aws-lambda.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./adapters/static": {
      "types": "./dist/adapters/static.d.ts",
      "default": "./dist/adapters/static.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./native-escape": {
      "types": "./dist/native-escape.d.ts",
      "default": "./dist/native-escape.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./internal/native-escape": {
      "types": "./dist/native-escape.d.ts",
      "default": "./dist/native-escape.js"
    },
    "./internal/session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reckona/mreact-compiler": "workspace:*",
    "@reckona/mreact-devtools": "workspace:*",
    "@reckona/mreact-query": "workspace:*",
    "@reckona/mreact-server": "workspace:*",
    "@reckona/mreact-shared": "workspace:*",
    "esbuild": "^0.28.0"
  },
  "peerDependencies": {
    "vite": ">=8 <9"
  },
  "optionalDependencies": {
    "@reckona/mreact-router-native": "workspace:*"
  }
}
