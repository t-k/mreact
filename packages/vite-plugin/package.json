{
  "name": "@reckona/mreact-vite",
  "version": "0.0.114",
  "description": "Vite plugin for compiling mreact modules.",
  "keywords": [
    "compiler",
    "jsx",
    "mreact",
    "plugin",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/vite-plugin#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reckona/mreact-compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=8 <9"
  }
}
