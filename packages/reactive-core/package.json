{
  "name": "@reckona/mreact-reactive-core",
  "version": "0.0.77",
  "description": "Fine-grained reactive primitives used across mreact.",
  "keywords": [
    "jsx",
    "mreact",
    "primitives",
    "reactivity",
    "signals",
    "typescript"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/reactive-core#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/reactive-core"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime-state": {
      "types": "./dist/runtime-state-public.d.ts",
      "default": "./dist/runtime-state-public.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
