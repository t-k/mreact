{
  "name": "@modular-react/server",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@modular-react/react-compat": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
