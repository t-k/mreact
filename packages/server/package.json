{
  "name": "@reckona/mreact-server",
  "version": "0.0.134",
  "description": "Server rendering, streaming, hydration, and Flight primitives for mreact.",
  "keywords": [
    "flight",
    "jsx",
    "mreact",
    "server",
    "ssr",
    "streaming",
    "typescript"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/server"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reorder": {
      "types": "./dist/reorder.d.ts",
      "default": "./dist/reorder.js"
    },
    "./flight": {
      "types": "./dist/flight.d.ts",
      "default": "./dist/flight.js"
    },
    "./buffer-sink": {
      "types": "./dist/buffer-sink.d.ts",
      "default": "./dist/buffer-sink.js"
    },
    "./boundary": {
      "types": "./dist/boundary.d.ts",
      "default": "./dist/boundary.js"
    },
    "./html-helpers": {
      "types": "./dist/html-helpers.d.ts",
      "default": "./dist/html-helpers.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reckona/mreact-compat": "workspace:*",
    "@reckona/mreact-shared": "workspace:*"
  }
}
