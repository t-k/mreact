{
  "name": "@reckona/mreact",
  "version": "0.0.193",
  "description": "React-flavored public runtime entrypoint for mreact.",
  "keywords": [
    "jsx",
    "jsx-runtime",
    "mreact",
    "react",
    "runtime",
    "typescript"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/react"
  },
  "files": [
    "*.cjs",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./index.cjs",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./jsx-runtime.cjs",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "require": "./jsx-dev-runtime.cjs",
      "default": "./dist/jsx-dev-runtime.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reckona/mreact-compat": "workspace:*"
  }
}
