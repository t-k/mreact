{
  "name": "@reckona/mreact-router-native",
  "version": "0.0.204",
  "description": "Native addon loader for mreact router runtime hot paths.",
  "keywords": [
    "addon",
    "jsx",
    "mreact",
    "native",
    "router",
    "typescript"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/router-native#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/router-native"
  },
  "files": [
    "index.cjs",
    "index.d.ts"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "cargo build --release && node scripts/copy-binary.cjs",
    "test": "cargo test --locked",
    "test:deny": "cargo deny check --config deny.toml bans licenses sources",
    "test:deny:advisories": "cargo deny check --config deny.toml advisories",
    "test:doc": "cargo test --locked --doc",
    "test:fuzz:base64": "cargo +nightly fuzz run decode_flight_base64 -- -max_len=4096 -max_total_time=60 -timeout=5",
    "test:fuzz:rows": "cargo +nightly fuzz run decode_flight_rows -- -max_len=4096 -max_total_time=60 -timeout=5",
    "test:mutants": "cargo mutants --test-tool nextest --jobs 2 --timeout 60",
    "test:nextest": "cargo nextest run --locked"
  },
  "optionalDependencies": {
    "@reckona/mreact-router-native-darwin-arm64": "workspace:*",
    "@reckona/mreact-router-native-linux-x64-gnu": "workspace:*",
    "@reckona/mreact-router-native-win32-x64-msvc": "workspace:*"
  }
}
