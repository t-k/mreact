{
  "name": "@reckona/mreact-scheduler",
  "version": "0.0.95",
  "description": "Scheduler-compatible API used by the mreact compatibility runtime.",
  "keywords": [
    "compatibility",
    "jsx",
    "mreact",
    "react",
    "scheduler",
    "typescript"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/scheduler#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/scheduler"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reckona/mreact-compat": "workspace:*"
  }
