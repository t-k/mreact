{
  "name": "@reckona/mreact-auth",
  "version": "0.0.160",
  "description": "Session and authorization helpers for mreact app router applications.",
  "keywords": [
    "auth",
    "authorization",
    "jsx",
    "mreact",
    "router",
    "sessions",
    "typescript"
  ],
  "homepage": "https://github.com/t-k/mreact/tree/main/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reckona/mreact-reactive-core": "workspace:*",
    "@reckona/mreact-router": "workspace:*"
  }
}
