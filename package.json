{
  "name": "mreact",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format": "oxfmt --check package.json tsconfig.base.json tsconfig.json vitest.config.ts",
    "format:write": "oxfmt package.json tsconfig.base.json tsconfig.json vitest.config.ts"
  },
  "devDependencies": {
    "happy-dom": "^20.9.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.19.0"
}
