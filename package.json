{
  "name": "mreact",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "pnpm build && tsx benchmarks/run.ts",
    "bench:frameworks": "pnpm build && tsx benchmarks/framework/run.ts",
    "bench:update": "pnpm build && UPDATE_BENCHMARK_BASELINE=1 tsx benchmarks/run.ts",
    "bench:frameworks:update": "pnpm build && UPDATE_FRAMEWORK_BENCHMARK_BASELINE=1 tsx benchmarks/framework/run.ts",
    "build": "tsc -b",
    "example:next:build": "pnpm build && pnpm --filter @modular-react/example-next-app-router build",
    "example:mreact-app-router:build": "pnpm build && pnpm --filter @modular-react/example-mreact-app-router build",
    "example:mreact-app-router:dev": "pnpm --filter @modular-react/example-mreact-app-router dev",
    "size": "tsx size/run.ts",
    "size:check": "CHECK_BUNDLE_SIZE_BUDGET=1 tsx size/run.ts",
    "size:update": "UPDATE_BUNDLE_SIZE_BASELINE=1 tsx size/run.ts",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && playwright test",
    "test:react-conformance": "vitest run packages/react-compat/test/react-official-conformance.test.ts packages/react-compat/test/react-official-suite-gate.test.ts packages/react/test/drop-in-react.test.ts packages/react-dom/test/drop-in-react-dom.test.ts packages/scheduler/test/drop-in-scheduler.test.ts",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format": "oxfmt --check package.json tsconfig.base.json tsconfig.json vitest.config.ts",
    "format:write": "oxfmt package.json tsconfig.base.json tsconfig.json vitest.config.ts"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.19.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "marko": "^5.38.39",
    "next": "^16.2.6",
    "oxc-parser": "0.129.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "solid-js": "^1.9.12",
    "tinybench": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "latest",
    "vite": "^8.0.11",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.19.0"
}
