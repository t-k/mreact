{
  "name": "mreact",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "pnpm build && tsx benchmarks/run.ts",
    "bench:update": "pnpm build && UPDATE_BENCHMARK_BASELINE=1 tsx benchmarks/run.ts",
    "build": "tsc -b",
    "size": "tsx size/run.ts",
    "size:check": "CHECK_BUNDLE_SIZE_BUDGET=1 tsx size/run.ts",
    "size:update": "UPDATE_BUNDLE_SIZE_BASELINE=1 tsx size/run.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format": "oxfmt --check package.json tsconfig.base.json tsconfig.json vitest.config.ts",
    "format:write": "oxfmt package.json tsconfig.base.json tsconfig.json vitest.config.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "tinybench": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "latest",
    "vite": "^8.0.11",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.19.0"
}
