{
  "name": "mreact",
  "version": "0.0.43",
  "private": true,
  "description": "mreact monorepo.",
  "homepage": "https://github.com/t-k/mreact#readme",
  "bugs": {
    "url": "https://github.com/t-k/mreact/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-k/mreact.git"
  },
  "type": "module",
  "scripts": {
    "bench": "pnpm bench:all",
    "bench:primitive": "NODE_ENV=production pnpm build && NODE_ENV=production tsx benchmarks/primitive/run.ts",
    "bench:html-escape": "NODE_ENV=production pnpm build && NODE_ENV=production tsx benchmarks/primitive/html-escape.ts",
    "bench:request-fastpaths": "NODE_ENV=production pnpm build && NODE_ENV=production tsx benchmarks/primitive/request-fastpaths.ts",
    "bench:router": "NODE_ENV=production pnpm build && NODE_ENV=production tsx benchmarks/router/run.ts",
    "bench:router-build": "NODE_ENV=production pnpm build && NODE_ENV=production tsx benchmarks/router/build-time.ts",
    "bench:lambda-routes": "NODE_ENV=production pnpm build && NODE_ENV=production tsx benchmarks/lambda-route-latency/run.ts",
    "bench:all": "pnpm bench:primitive && pnpm bench:router && pnpm bench:lambda-routes",
    "build": "tsc -b",
    "docs:api": "pnpm build && typedoc --options typedoc.json",
    "docs:api:check": "pnpm build && typedoc --options typedoc.json --emit none",
    "api:report": "pnpm build && node scripts/generate-api-reports.mjs",
    "api:report:check": "pnpm build && node scripts/generate-api-reports.mjs --check",
    "example:mreact-app-router:build": "pnpm build && pnpm --filter @reckona/example-app-router build",
    "example:mreact-app-router:dev": "pnpm --filter @reckona/example-app-router dev",
    "size": "tsx size/run.ts",
    "size:check": "CHECK_BUNDLE_SIZE_BUDGET=1 tsx size/run.ts",
    "size:update": "UPDATE_BUNDLE_SIZE_BASELINE=1 tsx size/run.ts",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && playwright test",
    "test:react-conformance": "vitest run packages/react-compat/test/react-official-conformance.test.ts packages/react-compat/test/react-official-suite-gate.test.ts packages/react/test/drop-in-react.test.ts packages/react-dom/test/drop-in-react-dom.test.ts packages/scheduler/test/drop-in-scheduler.test.ts",
    "test:watch": "vitest",
    "lint": "oxlint . --ignore-pattern docs/api/**",
    "format": "oxfmt --check package.json tsconfig.base.json tsconfig.json typedoc.json vitest.config.ts",
    "format:write": "oxfmt package.json tsconfig.base.json tsconfig.json typedoc.json vitest.config.ts",
    "publish:packages": "node scripts/publish-packages.mjs",
    "publish:verify": "node scripts/verify-package-tarballs.mjs",
    "release:version": "node scripts/bump-package-versions.mjs"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.19.2",
    "@microsoft/api-extractor": "^7.58.7",
    "@playwright/test": "^1.60.0",
    "@qwik.dev/core": "2.0.0-beta.35",
    "@qwik.dev/router": "2.0.0-beta.35",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "happy-dom": "^20.9.0",
    "marko": "^5.38.39",
    "next": "^16.2.6",
    "oxc-parser": "0.129.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "solid-js": "^1.9.12",
    "solid-js-2": "npm:solid-js@2.0.0-beta.13",
    "tinybench": "^6.0.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
